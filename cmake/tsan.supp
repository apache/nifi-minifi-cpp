# ThreadSanitizer suppressions for MiNiFi C++ test runs.
#
# Wired in via TSAN_OPTIONS=suppressions=... in cmake/BuildTests.cmake.
# Format reference: https://github.com/google/sanitizers/wiki/ThreadSanitizerSuppressions

# --- libc++ (not instrumented) ---
# promise<void> and future<void> are implemented in libc++.so, so TSan cannot see the atomic refcount
# decrements which order the waiting thread's last access to the shared state before the delete in ~promise().
race:std::__1::promise<void>::~promise

# --- OpenSSL ---
# CRYPTO_malloc reads/clears the plain int allow_customize without locking; it only goes 1 -> 0
# on the first allocation and only disables CRYPTO_set_mem_functions, so the race is benign.
race:allow_customize
